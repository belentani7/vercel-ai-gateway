# Copy to .env. Never commit a real key or put it in client-side code.
AI_GATEWAY_API_KEY=
# Set after checking the current catalog at https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_MODEL=
AI_GATEWAY_VIDEO_MODEL=
# Video generation may incur substantial charges; only run it intentionally.
AI_GATEWAY_VIDEO_OUTPUT=generated-video.mp4
